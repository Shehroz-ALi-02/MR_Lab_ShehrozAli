<?xml version="1.0"?>
<robot name="industrial_amr">

  <material name="industrial_yellow">
    <color rgba="1.0 0.65 0.0 1.0"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="light_grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="sensor_blue">
    <color rgba="0.0 0.4 0.8 1.0"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/> </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.45 0.15"/>
      </geometry>
      <material name="industrial_yellow"/>
    </visual>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.25 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.25 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_caster">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.22 0 -0.09" rpy="0 0 0"/>
  </joint>

  <link name="rear_caster">
    <visual>
      <geometry>
        <sphere radius="0.04"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.22 0 -0.09" rpy="0 0 0"/>
  </joint>

  <link name="top_plate">
    <visual>
      <geometry>
        <box size="0.58 0.43 0.02"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
  </link>

  <joint name="top_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="top_plate"/>
    <origin xyz="0 0 0.085" rpy="0 0 0"/> </joint>

  <link name="lidar_tower">
    <visual>
      <geometry>
        <cylinder length="0.06" radius="0.03"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="lidar_tower_joint" type="fixed">
    <parent link="top_plate"/>
    <child link="lidar_tower"/>
    <origin xyz="0.2 0 0.04" rpy="0 0 0"/>
  </joint>

  <link name="lidar_sensor">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.045"/>
      </geometry>
      <material name="sensor_blue"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_tower"/>
    <child link="lidar_sensor"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

</robot>
